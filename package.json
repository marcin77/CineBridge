{
  "name": "cinebridge",
  "version": "1.1.0",
  "description": "Migruj historię filmową z Filmweb do Letterboxd, Trakt, Simkl i innych serwisów",
  "author": "Marcin77",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:prepare": "node scripts/prepare-electron-build.js",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3",
    "pack:linux": "electron-builder --linux AppImage",
    "pack:win": "electron-builder --win nsis",
    "build:linux": "npm run build && npm run electron:prepare && npm run rebuild:electron && npm run pack:linux",
    "build:win": "npm run build && npm run electron:prepare && npm run rebuild:electron && npm run pack:win",
    "dist": "npm run build:linux"
  },
  "dependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/papaparse": "^5.5.2",
    "autoprefixer": "^10.5.4",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "js-cookie": "^3.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^1.30.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "p-limit": "^7.3.1",
    "papaparse": "^5.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "^9.0.0",
    "drizzle-kit": "0.31.10",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-icon-builder": "^2.0.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5.8",
    "typescript": "5.9.3",
    "wait-on": "^8.0.0"
  }
}
