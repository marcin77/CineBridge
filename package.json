{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "electron:prepare": "node scripts/prepare-electron-build.js",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on tcp:3000 && electron .\"",
    "dist:win": "npm run electron:prepare && electron-builder --win --config electron-builder.yml",
    "dist:linux": "npm run electron:prepare && electron-builder --linux AppImage --config electron-builder.yml"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-cookie": "^3.0.6",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-react": "^6.0.5",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.30.0",
    "next": "^16.3.0",
    "papaparse": "^5.5.4",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5.26",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "wait-on": "^9.1.0"
  }
}
